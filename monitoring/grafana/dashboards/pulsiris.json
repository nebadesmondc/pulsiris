          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(pulsiris_checks_seconds_count[$__rate_interval])) * 60",
          "legendFormat": "{{outcome}}",
          "refId": "A"
